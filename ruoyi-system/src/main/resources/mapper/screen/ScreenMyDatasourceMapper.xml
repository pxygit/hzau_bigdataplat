<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ScreenMyDatasourceMapper">

    <resultMap type="ScreenMyDatasource" id="ScreenMyDatasourceResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="datasourceId"    column="datasource_id"    />
        <result property="authStatus"    column="auth_status"    />
        <result property="authTime"    column="auth_time"    />
        <result property="authBy"    column="auth_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectScreenMyDatasourceVo">
        select id, user_id, datasource_id, auth_status, auth_time, auth_by, remark from screen_my_datasource
    </sql>

    <select id="selectScreenMyDatasourceList" parameterType="ScreenMyDatasource" resultMap="ScreenMyDatasourceResult">
        <include refid="selectScreenMyDatasourceVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="datasourceId != null "> and datasource_id = #{datasourceId}</if>
            <if test="authStatus != null "> and auth_status = #{authStatus}</if>
        </where>
    </select>

    <select id="selectScreenMyDatasourceById" parameterType="Long" resultMap="ScreenMyDatasourceResult">
        <include refid="selectScreenMyDatasourceVo"/>
        where id = #{id}
    </select>

    <insert id="insertScreenMyDatasource" parameterType="ScreenMyDatasource" useGeneratedKeys="true" keyProperty="id">
        insert into screen_my_datasource
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="datasourceId != null">datasource_id,</if>
            <if test="authStatus != null">auth_status,</if>
            <if test="authTime != null">auth_time,</if>
            <if test="authBy != null">auth_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="datasourceId != null">#{datasourceId},</if>
            <if test="authStatus != null">#{authStatus},</if>
            <if test="authTime != null">#{authTime},</if>
            <if test="authBy != null">#{authBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateScreenMyDatasource" parameterType="ScreenMyDatasource">
        update screen_my_datasource
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="datasourceId != null">datasource_id = #{datasourceId},</if>
            <if test="authStatus != null">auth_status = #{authStatus},</if>
            <if test="authTime != null">auth_time = #{authTime},</if>
            <if test="authBy != null">auth_by = #{authBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteScreenMyDatasourceById" parameterType="Long">
        delete from screen_my_datasource where id = #{id}
    </delete>

    <delete id="deleteScreenMyDatasourceByIds" parameterType="String">
        delete from screen_my_datasource where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>